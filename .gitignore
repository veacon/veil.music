# ─── Secrets / runtime state (NEVER commit) ───────────────────────────
server/auth-state.json
**/auth-state.json
*.mut
.env
.env.local
secrets.json

# ─── Node / Bun ───────────────────────────────────────────────────────
node_modules/
bun.lockb
npm-debug.log*
yarn-error.log

# ─── Android / Gradle ─────────────────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/captures/
android/local.properties
*.apk
*.aab
*.keystore
*.jks
.cxx/

# ─── IDE / OS ─────────────────────────────────────────────────────────
.idea/
*.iml
.DS_Store
*.log

# ─── Caches / temp ────────────────────────────────────────────────────
am_stream_cache/
__pycache__/
*.pyc
/tmp/
scratchpad/

# ─── Dev scratch / debug artifacts (not part of the source) ──────────
.tmp/
.shots/
shots/
dist/
.tmp_localize.py
Crop.java
RowScan.java
RowScan2.java
hs_err_pid*.log
replay_pid*.log
*.png
# Android TV launcher icon / banner are real app resources, not dev screenshots —
# never let the blanket *.png rule above drop them from the repository.
!android/app/src/main/res/**/*.png
