"javascript:(() => { if (location.protocol !== 'https:' || location.hostname !== 'music.apple.com') { alert('请先在 Safari 打开 Apple Music 网页版并登录，保持在 Apple Music 页面上，再点这个书签。'); return; } let token = ''; try { token = window.MusicKit.getInstance().musicUserToken || ''; } catch (e) {} if (!token) { const match = document.cookie.match(/(?:^|;\\s*)media-user-token=([^;]*)/); if (match) { try { token = decodeURIComponent(match[1]); } catch (e) {} } } if (typeof token !== 'string' || !token) { alert('未找到令牌，请先登录 Apple Music 网页版，打开资料库并等待加载后再试。'); return; } document.getElementById('amtv-token-bookmark-v2')?.remove(); const host = document.createElement('div'); host.id = 'amtv-token-bookmark-v2'; host.style.cssText = 'all:initial!important;position:fixed!important;inset:0!important;z-index:2147483647!important;display:block!important;'; const shadow = host.attachShadow({mode:'closed'}); shadow.innerHTML = '\u003cstyle>:host{color-scheme:light}*{box-sizing:border-box}.backdrop{position:absolute;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;padding:20px;font:16px/1.5 -apple-system,BlinkMacSystemFont,sans-serif;color:rgb(30,30,30)}.panel{background:white;border-radius:18px;padding:24px;width:100%;max-width:420px;max-height:85vh;overflow:auto;box-shadow:0 16px 60px rgba(0,0,0,.25)}h2{font-size:20px;margin:0 0 12px}textarea{display:block;width:100%;height:96px;font:13px/1.5 monospace;padding:10px;border:1px solid silver;border-radius:8px;background:rgb(248,248,248);color:rgb(30,30,30);resize:none}p{margin:12px 0;font-size:14px;color:rgb(90,90,90)}.buttons{display:flex;gap:12px}button{flex:1;border:0;border-radius:10px;padding:12px;font:600 16px -apple-system,sans-serif;background:rgb(239,239,239);color:rgb(30,30,30)}.copy{background:rgb(191,58,79);color:white}\u003c/style>\u003cdiv class=\"backdrop\">\u003csection class=\"panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"title\">\u003ch2 id=\"title\">Apple Music 令牌\u003c/h2>\u003ctextarea readonly aria-label=\"用户令牌\" spellcheck=\"false\" autocapitalize=\"off\">\u003c/textarea>\u003cp role=\"status\" aria-live=\"polite\">点击下方按钮复制到剪贴板。\u003c/p>\u003cdiv class=\"buttons\">\u003cbutton type=\"button\" class=\"close\">关闭\u003c/button>\u003cbutton type=\"button\" class=\"copy\">复制令牌\u003c/button>\u003c/div>\u003c/section>\u003c/div>'; const text = shadow.querySelector('textarea'); const status = shadow.querySelector('[role=\"status\"]'); const copy = shadow.querySelector('.copy'); text.value = token; shadow.querySelector('.close').onclick = () => host.remove(); copy.onclick = async () => { try { await navigator.clipboard.writeText(token); copy.textContent = '已复制'; status.textContent = '已复制，可以返回电视配置页粘贴。'; } catch (e) { copy.textContent = '重试复制'; text.focus(); text.select(); text.setSelectionRange(0, text.value.length); status.textContent = 'Safari 未允许自动复制，请长按上方令牌，选择“全选”后复制。'; } }; document.documentElement.appendChild(host); })();"